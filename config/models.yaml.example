# Provider priority: lmstudio (primary) > ollama (alternative) > vllm
#
# LM Studio:  http://localhost:1234  (OpenAI-compatible Chat API)
# Ollama:     http://localhost:11434 (Ollama native API)
# vLLM:       http://localhost:8000  (OpenAI-compatible Completions API)
# oobabooga:  http://localhost:5000  (text-generation-webui, OpenAI-compatible)

# Provider connection settings (URL can be changed at runtime via UI)
providers:
  lmstudio:
    url: "http://localhost:1234"
  ollama:
    url: "http://localhost:11434"
  vllm:
    url: "http://localhost:8000"
  oobabooga:
    url: "http://localhost:5000"

models:
  qwen3.5-9b:
    provider: lmstudio
    context: 32768
    tier: high
    capabilities:
      - reasoning
      - planning
    fallback:
      name: qwen2.5-coder-7b
      provider: ollama

  qwen2.5-coder-7b:
    provider: lmstudio
    context: 32768
    tier: standard
    capabilities:
      - coding
      - debugging
    fallback:
      name: qwen2.5-coder-7b
      provider: ollama

  deepseek-coder:
    provider: lmstudio
    context: 32768
    tier: high
    capabilities:
      - coding
    fallback:
      name: qwen2.5-coder-7b
      provider: ollama

# Tier definitions:
#   high     - For planning, review, architecture (CTO, Reviewer)
#   standard - For execution tasks (Engineer, Tester, Optimizer)
#   light    - For simple tasks (Documenter, routine checks)
